# Vorlage für docker compose:  cp .env.example .env
#
# Hier stehen NUR Zugangsdaten (API-Keys, Admin-Passwort) und Infrastruktur (Port, Proxy).
# Alles andere – KI-Anbieter und Modell, Bewertungsverfahren, Übersetzer, Quellen, Zeitraum, Zeitplan –
# stellt der Admin bequem im Web-UI unter /admin ein. API-Keys werden aus Sicherheitsgründen nie in
# der Datenbank gespeichert; nach einer Änderung hier den Container neu starten:  docker compose up -d

# ---------------------------------------------------------------- Infrastruktur
# Port nach außen. Nur wenn gesetzt, wird er veröffentlicht; leer = nur im Docker-Netz (Reverse-Proxy).
# Nur lokal erreichbar: PORT=127.0.0.1:8000
PORT=8000
# TZ=Europe/Berlin
# LOG_LEVEL=INFO
# Nur bei Internetzugang über einen Proxy:
# HTTPS_PROXY=http://proxy.firma.local:3128
# HTTP_PROXY=http://proxy.firma.local:3128

# Optionaler freier Übersetzungsserver ohne API-Key als zweiter Container (wird automatisch erkannt):
# COMPOSE_PROFILES=uebersetzung
# LT_LOAD_ONLY=en,de,zh-Hans

# ---------------------------------------------------------------- Zugangsdaten
# Admin-Passwort (Benutzer: admin). Leer = wird beim ersten Start erzeugt und im Log ausgegeben.
ADMIN_PASSWORD=

# KI-Anbieter: nur den Key des im Web-UI gewählten Anbieters eintragen.
# LLM_API_KEY gilt für jeden Anbieter; die anbieterspezifischen Namen gehen ebenso.
LLM_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=          # kostenlos: https://aistudio.google.com -> „Get API key“
# GROQ_API_KEY=            # kostenloser Tarif: https://console.groq.com
# MISTRAL_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# AZURE_OPENAI_API_KEY=

# Entscheidungsmodell (Zero-Shot-Klassifikation) über Hugging Face, kostenloser Token:
# https://huggingface.co/settings/tokens  (Typ „Read“ bzw. „Inference“)
# HF_TOKEN=

# Übersetzung (optional)
# DEEPL_API_KEY=           # kostenloser Tarif, Key endet auf :fx
# LIBRETRANSLATE_API_KEY=  # nur für öffentliche Instanzen mit Key-Pflicht

# Vorlage für docker compose: nach .env kopieren und bei Bedarf anpassen.
#   cp .env.example .env
# Alles ist optional; leere Werte bedeuten den eingebauten Standard.

# Port, unter dem die Weboberfläche erreichbar ist
PORT=8000

# Admin-Zugang (Benutzer: admin). Leer = Passwort wird erzeugt und im Log ausgegeben.
ADMIN_PASSWORD=

# Optional: KI-Analyse mit Claude. Leer = rein regelbasiert.
ANTHROPIC_API_KEY=
# NNIGN_LLM_MODEL=claude-opus-5-5     # günstiger: claude-haiku-5-5

# Zeitplan und Historie
# NNIGN_SCAN_INTERVAL_HOURS=4
# NNIGN_BACKFILL_SINCE=2000-01-01
# NNIGN_BACKFILL_ENABLED=true

# Übersicht ohne Login sichtbar (false = auch Lesen nur mit Admin-Login)
# NNIGN_PUBLIC_DASHBOARD=true

# Nur bei Internetzugang über einen Proxy
# HTTPS_PROXY=http://proxy.firma.local:3128
# HTTP_PROXY=http://proxy.firma.local:3128

# TZ=Europe/Berlin
# LOG_LEVEL=INFO

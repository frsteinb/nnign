# Vorlage für docker compose: nach .env kopieren und bei Bedarf anpassen.
#   cp .env.example .env
# Alles ist optional; leere Werte bedeuten den eingebauten Standard.

# Port, unter dem die Weboberfläche erreichbar ist
PORT=8000

# Admin-Zugang (Benutzer: admin). Leer = Passwort wird erzeugt und im Log ausgegeben.
ADMIN_PASSWORD=

# ---------------------------------------------------------------- KI-Analyse (optional)
# Ohne Konfiguration arbeitet das System rein regelbasiert. Ein Anbieter genügt.
#
# Anbieter: anthropic (Standard) | openai | azure | gemini | mistral | groq | openrouter | ollama
#           | openai_compatible (beliebiger OpenAI-kompatibler Server über LLM_BASE_URL)
LLM_PROVIDER=
# Modell: bei anthropic optional (Standard claude-opus-5-5, günstiger claude-haiku-5-5),
# bei allen anderen Pflicht; bei azure der Name des Deployments.
LLM_MODEL=
# API-Key: entweder allgemein hier ...
LLM_API_KEY=
# ... oder anbieterspezifisch (wird genutzt, wenn LLM_API_KEY leer ist):
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Eigene Basis-URL (nur nötig bei openai_compatible, azure, ollama oder Proxys wie LiteLLM)
# LLM_BASE_URL=
#
# Beispiele:
#   OpenAI:      LLM_PROVIDER=openai      LLM_MODEL=<modellname>  OPENAI_API_KEY=sk-...
#   Azure:       LLM_PROVIDER=azure       LLM_MODEL=<deployment>  AZURE_OPENAI_API_KEY=...
#                AZURE_OPENAI_ENDPOINT=https://<ressource>.openai.azure.com
#                AZURE_OPENAI_API_VERSION=2024-10-21
#   Gemini:      LLM_PROVIDER=gemini      LLM_MODEL=<modellname>  GEMINI_API_KEY=...
#   Mistral:     LLM_PROVIDER=mistral     LLM_MODEL=<modellname>  MISTRAL_API_KEY=...
#   Ollama:      LLM_PROVIDER=ollama      LLM_MODEL=<z. B. llama3.1>  (läuft auf dem Docker-Host,
#                Standard-URL http://host.docker.internal:11434/v1, sonst LLM_BASE_URL bzw. OLLAMA_HOST)
#   LM Studio, vLLM, LiteLLM …:
#                LLM_PROVIDER=openai_compatible  LLM_BASE_URL=http://host:port/v1  LLM_MODEL=<name>

# Zeitplan und Erfassungszeitraum
# NNIGN_SCAN_INTERVAL_HOURS=4
# Leer = beim ersten Start die letzten vier Wochen. Bequemer im Admin-Bereich unter „Daten & Erfassungszeitraum“.
# NNIGN_COLLECT_SINCE=2000-01-01
# NNIGN_COLLECT_UNTIL=
# NNIGN_BACKFILL_ENABLED=true

# Übersicht ohne Login sichtbar (false = auch Lesen nur mit Admin-Login)
# NNIGN_PUBLIC_DASHBOARD=true

# Nur bei Internetzugang über einen Proxy
# HTTPS_PROXY=http://proxy.firma.local:3128
# HTTP_PROXY=http://proxy.firma.local:3128

# TZ=Europe/Berlin
# LOG_LEVEL=INFO
